NODE_ENV=development
PORT=3000
DEFAULT_CREATED_BY=admin@example.com

# Local MySQL connection. Create the database by running sql/schema.sql first.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=edgenroots_formula_engine
DB_CONNECTION_LIMIT=12
DB_QUEUE_LIMIT=0

# Evaluation controls
FORMULA_TIMEOUT_MS=1000
FORMULA_CONCURRENCY=8
BULK_RECORD_CONCURRENCY=4
MAX_BULK_RECORDS=500
